# Cloudflare cache rules for the static site (read by Workers static assets; not served to visitors).
# Files whose names change when their content changes are cached for a year.
# Images/videos keep their names when replaced, so they are cached for a week and refreshed in the background.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/vid/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/icon-*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

# Site scripts are edited in place: short cache so changes show up quickly.
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
